{
  "name": "lichess-to-chesscom-review",
  "version": "1.1.0",
  "private": true,
  "description": "Open the Lichess game you are looking at on Chess.com's analysis board, ready for Game Review.",
  "license": "MIT",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b chrome && wxt zip -b firefox --mv3",
    "lint": "eslint . && prettier --check . && pnpm lint:firefox",
    "lint:firefox": "pnpm build:firefox && web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "pnpm build:chrome && playwright test",
    "postinstall": "wxt prepare",
    "icons": "node scripts/export-icons.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@webext-core/fake-browser": "2.0.1",
    "chrome-webstore-upload-cli": "4.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
